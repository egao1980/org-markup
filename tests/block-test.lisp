(in-package #:org-markup/tests)

(deftest parse-headings
  (ok (equal '((:heading 1 ("a"))) (po "* a")))
  (ok (equal '((:heading 3 ("three"))) (po "*** three")))
  (ok (equal '((:heading 6 ("eight"))) (po "******** eight")) "level capped at 6")
  (ok (equal '((:heading 1 ())) (po "*")) "stars alone: an empty heading")
  (ok (equal '((:paragraph ((:strong ("bold")) " text"))) (po "*bold* text"))
      "the space after the stars is required")
  (ok (equal '((:bullet-list t (((:paragraph ("x")))))) (po " * x"))
      "an indented * is a bullet, not a heading")
  (ok (equal '((:heading 2 ("Write post"))) (po "** TODO [#A] Write post   :blog:draft:"))
      "TODO keyword, priority cookie and tags stripped")
  (ok (equal '((:heading 1 ("Shipped"))) (po "* DONE Shipped")))
  (ok (equal '((:heading 1 ())) (po "* TODO")) "a keyword alone")
  (ok (equal '((:heading 1 ("TODOS are text"))) (po "* TODOS are text")))
  (ok (equal '((:heading 1 ("todo lower"))) (po "* todo lower")) "keywords are case-sensitive")
  (ok (equal '((:heading 1 ("[#AB] x"))) (po "* [#AB] x")) "a cookie has one character")
  (ok (equal '((:heading 1 ("Title"))) (po "* Title :tag:")))
  (ok (equal '((:heading 1 ())) (po "* :tag:")) "tags alone")
  (ok (equal '((:heading 1 ("Meet at 10:30:"))) (po "* Meet at 10:30:"))
      "a last word not starting with : is not tags")
  (ok (equal '((:heading 1 ("a :b c:"))) (po "* a :b c:")) "tags hold no spaces")
  (ok (equal '((:heading 1 ((:emph ("it")) " and " (:code "code")))) (po "* /it/ and =code="))
      "inline content")
  (ok (equal '((:paragraph ("p")) (:heading 1 ("h")) (:paragraph ("q"))) (po "p" "* h" "q"))
      "a heading interrupts a paragraph"))

(deftest parse-heading-planning-and-drawers
  (ok (equal '((:heading 1 ("h")) (:paragraph ("text")))
             (po "* h" "SCHEDULED: <2026-11-23 Mon>" "text"))
      "a planning line after a heading is dropped")
  (ok (equal '((:heading 1 ("h")) (:paragraph ("text")))
             (po "* h" "  DEADLINE: <2026-11-30> SCHEDULED: <2026-11-23>" "text")))
  (ok (equal '((:heading 1 ("h")) (:paragraph ("text")))
             (po "* h" "CLOSED: [2026-11-23]" ":PROPERTIES:" ":ID: 42" ":END:" "text"))
      "planning, then a property drawer")
  (ok (equal '((:paragraph ("SCHEDULED: <2026-11-23>")))
             (po "SCHEDULED: <2026-11-23>"))
      "a planning line elsewhere is text")
  (ok (equal '((:paragraph ("a")) (:paragraph ("b")))
             (po "a" "  :LOGBOOK:" "  - Note taken" "  :end:" "b"))
      "a drawer is dropped and interrupts a paragraph; :END: in any case")
  (ok (equal '((:paragraph (":NOTES:" (:soft-break) "x")))
             (po ":NOTES:" "x"))
      "without :END: it is not a drawer")
  (ok (equal '((:paragraph (":no spaces:"))) (po ":no spaces:")) "a drawer name has no spaces")
  (ok (equal '((:paragraph ("a")) (:paragraph ("b"))) (po "a" ":END:" "b"))
      "a stray :END: is dropped"))

(deftest parse-noexport-and-comment-subtrees
  (ok (equal '((:heading 1 ("Keep")) (:paragraph ("a")) (:heading 1 ("Next")) (:paragraph ("d")))
             (po "* Keep" "a" "* Drop :noexport:" "b" "** Sub" "c" "* Next" "d"))
      "a noexport heading drops its subtree")
  (ok (equal '((:heading 1 ("A")) (:heading 2 ("B")) (:heading 2 ("D")) (:heading 1 ("E")))
             (po "* A" "** B" "** C :x:noexport:" "*** C1" "text" "** D" "* E"))
      "the subtree ends at a heading with as many stars")
  (ok (equal '((:heading 1 ("A")) (:heading 1 ("E")))
             (po "* A" "** C :noexport:" "* E"))
      "or fewer")
  (ok (equal '((:paragraph ("intro"))) (po "intro" "* Drafts :noexport:" "** one" "x"))
      "to the end of the text")
  (ok (equal '((:heading 1 ("A")) (:heading 1 ("C")))
             (po "* A" "* COMMENT B" "secret" "** B1" "* C"))
      "a COMMENT heading drops its subtree")
  (ok (equal '((:heading 1 ("A")) (:heading 1 ("C")))
             (po "* A" "* TODO [#B] COMMENT B" "x" "* C"))
      "COMMENT after the keyword and priority")
  (ok (equal '((:heading 1 ("noexport"))) (po "* noexport")) "the word alone is a title")
  (ok (equal '((:heading 1 ("COMMENTS"))) (po "* COMMENTS"))))

(deftest parse-paragraphs-and-comments
  (ok (equal '((:paragraph ("a" (:soft-break) "b")) (:paragraph ("c")))
             (po "a" "   b" "" "" "c"))
      "continuation indent stripped; blank lines separate")
  (ok (equal '((:paragraph ("a" (:soft-break) "b"))) (po "a   " "b  "))
      "trailing whitespace dropped")
  (ok (equal '((:paragraph ("a" (:hard-break) "b"))) (po "a \\\\" "b")) "\\\\ at the end of a line")
  (ok (equal '((:paragraph ("x"))) (org:parse-org (format nil "x~C~C" #\Return #\Newline)))
      "CRLF")
  (ok (equal '((:paragraph ("a" (:soft-break) "b")))
             (org:parse-org (format nil "a~C~Cb~C~C" #\Return #\Newline #\Return #\Newline))))
  (ok (null (org:parse-org "")) "empty input")
  (ok (null (po "" "   " "")) "blank input")
  (ok (signals (org:parse-org 42) 'type-error))
  (ok (signals (org:parse-org nil) 'type-error))
  (ok (signals (org:parse-org '(#\a)) 'type-error))
  (ok (null (po "# a comment" "#" "  # indented")) "comment lines are dropped")
  (ok (equal '((:paragraph ("a")) (:paragraph ("b"))) (po "a" "# c" "b"))
      "a comment interrupts a paragraph")
  (ok (equal '((:paragraph ("#hashtag"))) (po "#hashtag")) "# then a non-blank is text")
  (ok (equal '((:paragraph ("#+word"))) (po "#+word")) "#+ without a colon is text")
  (ok (equal '((:paragraph ("a")) (:paragraph ("b"))) (po "a" "#+KEY: v" "b"))
      "a keyword line interrupts a paragraph")
  (ok (equal '((:paragraph ("a")) (:paragraph ("b"))) (po "a" "#+END_SRC" "b"))
      "a stray end line is dropped"))

(deftest parse-src-and-example-blocks
  (ok (equal '((:code-block "lisp" ("(+ 1 2)")))
             (po "#+BEGIN_SRC lisp :results output" "(+ 1 2)" "#+END_SRC")))
  (ok (equal '((:code-block "python" ("x = 1" "" "y = 2")))
             (po "#+begin_src python" "x = 1" "" "y = 2" "#+end_src"))
      "any case; blank lines kept")
  (ok (equal '((:code-block nil ("a"))) (po "#+BEGIN_SRC" "a" "#+END_SRC")) "no language")
  (ok (equal '((:code-block nil ("a"))) (po "#+begin_src -n" "a" "#+end_src")) "a switch is no language")
  (ok (equal '((:code-block nil ("a"))) (po "#+begin_src :tangle x.el" "a" "#+end_src"))
      "a header argument is no language")
  (ok (equal '((:code-block nil ("an example" "  indented")))
             (po "#+BEGIN_EXAMPLE" "an example" "  indented" "#+END_EXAMPLE")))
  (ok (equal '((:code-block "sh" ("ls" "  -la" "" "pwd")))
             (po "  #+begin_src sh" "    ls" "      -la" "" "    pwd" "  #+end_src"))
      "the common indentation is removed")
  (ok (equal '((:code-block "org" ("* not a heading" "#+not: a keyword" ",* still escaped"
                                   "  * indented" ",x stays" "a ,* stays")))
             (po "#+begin_src org" ",* not a heading" ",#+not: a keyword" ",,* still escaped"
                 "  ,* indented" ",x stays" "a ,* stays" "#+end_src"))
      "comma escaping of * and #+")
  (ok (equal '((:code-block "lisp" ("x" "* not a heading" "" "- nor an item")))
             (po "#+BEGIN_SRC lisp" "x" "* not a heading" "" "- nor an item"))
      "unclosed: to the end of the container")
  (ok (equal '((:code-block nil ("a" "#+end_example"))) (po "#+begin_src" "a" "#+end_example" "#+end_src"))
      "only the matching end closes")
  (ok (equal '((:paragraph ("p")) (:code-block nil ("x")) (:paragraph ("q")))
             (po "p" "#+begin_example" "x" "#+end_example" "q"))
      "a block interrupts a paragraph")
  (ok (equal (list (list :code-block nil (list "x" "        y")))
             (org:parse-org (format nil "#+begin_example~%~Cx~%~C~Cy~%#+end_example~%"
                                    #\Tab #\Tab #\Tab)))
      "leading tabs become spaces (8-column stops)")
  (ok (equal '((:code-block nil ())) (po "#+begin_src" "#+end_src")) "empty block"))

(deftest parse-other-blocks
  (ok (equal '((:block-quote ((:paragraph ("Some " (:emph ("text")))) (:bullet-list t (((:paragraph ("a"))))))))
             (po "#+BEGIN_QUOTE" "Some /text/" "- a" "#+END_QUOTE")))
  (ok (equal '((:block-quote ((:code-block "c" ("int x;")))))
             (po "#+begin_quote" "#+begin_src c" "int x;" "#+end_src" "#+end_quote"))
      "blocks nest")
  (ok (equal '((:block-quote ((:paragraph ("a")) (:paragraph ("b")))))
             (po "#+begin_quote" "a" "" "b"))
      "unclosed quote: to the end")
  (ok (equal '((:paragraph ("Great clouds overhead" (:hard-break)
                            "  Tiny black birds rise and fall" (:hard-break) (:hard-break)
                            "Snow " (:emph ("covers")) " Emacs")))
             (po "#+BEGIN_VERSE" "" "  Great clouds overhead" "    Tiny black birds rise and fall"
                 "" "  Snow /covers/ Emacs" "" "#+END_VERSE"))
      "verse: one paragraph, hard breaks, relative indentation kept")
  (ok (null (po "#+begin_verse" "" "#+end_verse")) "empty verse")
  (ok (null (po "#+BEGIN_EXPORT html" "<b>raw</b>" "#+END_EXPORT")) "export blocks are dropped")
  (ok (null (po "#+begin_comment" "* hidden" "#+end_comment")) "comment blocks are dropped")
  (ok (equal '((:paragraph ("a")) (:paragraph ("b")))
             (po "a" "#+BEGIN_CENTER" "b" "#+END_CENTER"))
      "center: contents spliced")
  (ok (equal '((:paragraph ("Note: " (:strong ("x")))) (:paragraph ("after")))
             (po "#+begin_note" "Note: *x*" "#+end_note" "after"))
      "unknown special block: contents spliced")
  (ok (equal '((:table (nil) nil ((("a")))))
             (po "#+BEGIN: clocktable :scope file" "| a |" "#+END:"))
      "dynamic block: markers dropped, contents spliced"))

(deftest parse-fixed-width-and-rules
  (ok (equal '((:code-block nil ("sbcl --script run.lisp" "" "" " two")))
             (po ": sbcl --script run.lisp" ": " ":" ":  two")))
  (ok (equal '((:code-block nil ("indented"))) (po "  : indented")))
  (ok (equal '((:paragraph (":nospace"))) (po ":nospace")) "a colon then a non-blank is text")
  (ok (equal '((:paragraph ("p")) (:code-block nil ("x")) (:paragraph ("q")))
             (po "p" ": x" "q"))
      "fixed width interrupts a paragraph")
  (ok (equal '((:thematic-break)) (po "-----")))
  (ok (equal '((:thematic-break)) (po "  ----------  ")))
  (ok (equal '((:paragraph ("----"))) (po "----")) "four dashes are text")
  (ok (equal '((:paragraph ("a")) (:thematic-break) (:paragraph ("b"))) (po "a" "-----" "b"))
      "a rule interrupts a paragraph")
  (ok (equal '((:paragraph ("--- -- ---"))) (po "--- -- ---")) "no spaces inside a rule"))

(deftest parse-tables
  (ok (equal '((:table (nil nil) (("Name") ("Age")) ((("Bob") ("42")) (("Al") ()))))
             (po "| Name | Age |" "|------+-----|" "| Bob  | 42  |" "| Al   |     |"))
      "a rule after the first row: header")
  (ok (equal '((:table (nil nil) nil ((("a") ("b")) (("c") ("d")))))
             (po "| a | b |" "| c | d |"))
      "no rule: no header")
  (ok (equal '((:table (nil nil) nil ((("a") ("b")) (("c") ("d")))))
             (po "| a | b |" "| c | d |" "|---+---|"))
      "a rule later does not make a header")
  (ok (equal '((:table (nil) (("h")) ((("x")))))
             (po "|---|" "| h |" "|---|" "| x |" "|---|"))
      "rules before the header")
  (ok (equal '((:table (:left :center :right nil) nil ((("a") ("b") ("c") ("d")))))
             (po "| <l> | <c> | <r10> | <8> |" "| a | b | c | d |"))
      "alignment cookies; a width alone aligns nothing")
  (ok (equal '((:table (:right nil) (("a") ("b")) ((("1") ("2")))))
             (po "| a | b |" "|---+---|" "| <r> |  |" "| 1 | 2 |"))
      "a cookie row with empty cells, after the header")
  (ok (equal '((:table (:right nil) (("a") ("b")) ((("1") ("2")))))
             (po "| <r> | |" "| a | b |" "|---+---|" "| 1 | 2 |"))
      "a cookie row before the header")
  (ok (equal '((:table (nil nil nil) (("a") () ()) ((("1") ("2") ("3")))))
             (po "| a |" "|---|" "| 1 | 2 | 3 |"))
      "rows and header padded to the widest row")
  (ok (equal '((:table (nil nil) nil ((("a") ("b"))))) (po "| a | b"))
      "no closing pipe")
  (ok (equal '((:table (nil nil) nil ((((:code "x")) ((:strong ("y"))))))) (po "| =x= | *y* |"))
      "inline content in cells")
  (ok (equal '((:table (nil) nil ((("<x>"))))) (po "| <x> |"))
      "not a cookie: a data cell")
  (ok (equal '((:paragraph ("p")) (:table (nil) nil ((("a"))))) (po "p" "| a |"))
      "a table interrupts a paragraph")
  (ok (equal '((:table (nil) nil ((("a")))) (:paragraph ("b"))) (po "  | a |" "b"))
      "indented table; a non-table line ends it")
  (ok (null (po "|---+---|")) "rules alone: no table")
  (ok (equal '((:table (nil) nil ((())))) (po "|")) "a bare pipe: one empty cell"))

(deftest parse-bullet-lists
  (ok (equal '((:bullet-list t (((:paragraph ("a"))) ((:paragraph ("b")))))) (po "- a" "- b")))
  (ok (equal '((:bullet-list t (((:paragraph ("a"))) ((:paragraph ("b")))))) (po "+ a" "- b"))
      "- and + mix in one list")
  (ok (equal '((:bullet-list nil (((:paragraph ("a"))) ((:paragraph ("b")))))) (po "- a" "" "- b"))
      "a blank line between items: loose")
  (ok (equal '((:bullet-list nil (((:paragraph ("a")) (:paragraph ("b")))))) (po "- a" "" "  b"))
      "two blocks in an item with a blank between: loose")
  (ok (equal '((:bullet-list t (((:paragraph ("a" (:soft-break) "b")))))) (po "- a" "  b"))
      "continuation line")
  (ok (equal '((:bullet-list t (((:paragraph ("a" (:soft-break) "b")))))) (po "- a" " b"))
      "any indent past the bullet continues the item")
  (ok (equal '((:bullet-list t (((:paragraph ("a"))))) (:paragraph ("b"))) (po "- a" "b"))
      "a line at the bullet's indent ends the list")
  (ok (equal '((:bullet-list t (((:paragraph ("a"))
                                 (:bullet-list t (((:paragraph ("b"))) ((:paragraph ("c"))))))
                                ((:paragraph ("d"))))))
             (po "- a" "  - b" "  - c" "- d"))
      "nested")
  (ok (equal '((:bullet-list t (((:paragraph ("a")) (:bullet-list t (((:paragraph ("b")))))))))
             (po "- a" "  * b"))
      "* is a bullet inside an item")
  (ok (equal '((:bullet-list t (((:paragraph ("a"))
                                 (:bullet-list nil (((:paragraph ("b"))) ((:paragraph ("c"))))))
                                ((:paragraph ("d"))))))
             (po "- a" "  - b" "" "  - c" "- d"))
      "a blank inside the nested list makes only it loose")
  (ok (equal '((:bullet-list t (((:paragraph ("a"))))) (:bullet-list t (((:paragraph ("b"))))))
             (po "- a" "" "" "- b"))
      "two blank lines end the list")
  (ok (equal '((:bullet-list t (((:paragraph ("a"))))) (:paragraph ("b"))) (po "- a" "" "" "  b"))
      "also before an indented line")
  (ok (equal '((:bullet-list t (((:paragraph ("a"))) ()))) (po "- a" "-")) "an empty item")
  (ok (equal '((:bullet-list t (((:paragraph ("a"))))) (:ordered-list 1 #\. t (((:paragraph ("b"))))))
             (po "- a" "1. b"))
      "another kind starts another list")
  (ok (equal '((:paragraph ("p")) (:bullet-list t (((:paragraph ("x")))))) (po "p" "- x"))
      "an item interrupts a paragraph")
  (ok (equal '((:bullet-list t (((:paragraph ("[ ] todo"))) ((:paragraph ("[X] done"))))))
             (po "- [ ] todo" "- [X] done"))
      "checkboxes stay text")
  (ok (equal '((:paragraph ("-x" (:soft-break) "+y"))) (po "-x" "+y")) "a bullet needs a space")
  (ok (equal (list (list :bullet-list t (list (list (list :paragraph (list "a" '(:soft-break) "b"))))))
             (org:parse-org (format nil "- a~%~Cb~%" #\Tab)))
      "a tab-indented continuation"))

(deftest parse-list-blocks
  (ok (equal '((:bullet-list t (((:paragraph ("step")) (:code-block "sh" ("ls" "" "pwd")))
                                ((:paragraph ("next"))))))
             (po "- step" "  #+begin_src sh" "  ls" "" "  pwd" "  #+end_src" "- next"))
      "a block in an item keeps its blank line")
  (ok (equal '((:bullet-list t (((:paragraph ("step")) (:code-block "lisp" ("(defun f ()" "  1)"))))))
             (po "- step" "  #+begin_src lisp" "(defun f ()" "  1)" "  #+end_src"))
      "a block that starts in an item belongs to it through its end line")
  (ok (equal '((:bullet-list t (((:paragraph ("a")) (:code-block nil ("x"))))))
             (po "- a" "  : x"))
      "fixed width in an item")
  (ok (equal '((:bullet-list t (((:paragraph ("a")) (:table (nil) nil ((("1")))))))) (po "- a" "  | 1 |"))
      "a table in an item"))

(deftest parse-ordered-lists
  (ok (equal '((:ordered-list 1 #\. t (((:paragraph ("a"))) ((:paragraph ("b")))))) (po "1. a" "2. b")))
  (ok (equal '((:ordered-list 3 #\) t (((:paragraph ("a"))) ((:paragraph ("b")))))) (po "3) a" "9) b"))
      "the first number is the start")
  (ok (equal '((:ordered-list 1 #\. t (((:paragraph ("a"))) ((:paragraph ("b")))))) (po "1. a" "2) b"))
      "delimiters mix; the first one counts")
  (ok (equal '((:ordered-list 5 #\. t (((:paragraph ("five"))) ((:paragraph ("six"))))))
             (po "1. [@5] five" "2. six"))
      "a counter cookie on the first item sets the start")
  (ok (equal '((:ordered-list 1 #\. t (((:paragraph ("a"))) ((:paragraph ("b")))))) (po "1. a" "2. [@7] b"))
      "a later cookie is removed")
  (ok (equal '((:bullet-list t (((:paragraph ("[@3] x")))))) (po "- [@3] x"))
      "a cookie on a bullet item stays text")
  (ok (equal '((:ordered-list 10 #\. t (((:paragraph ("a" (:soft-break) "b"))))))
             (po "10. a" "    b"))
      "content column after a longer number")
  (ok (equal '((:ordered-list 1 #\. t (((:paragraph ("a")) (:bullet-list t (((:paragraph ("b")))))))))
             (po "1. a" "   - b")))
  (ok (equal '((:paragraph ("in")) (:ordered-list 2024 #\. t (((:paragraph ("it rained"))))))
             (po "in" "2024. it rained"))
      "an ordered item interrupts a paragraph, whatever its number")
  (ok (equal '((:paragraph ("1234567890. x"))) (po "1234567890. x")) "at most nine digits")
  (ok (equal '((:paragraph ("1.5 apples"))) (po "1.5 apples")) "a space after the delimiter"))

(deftest parse-description-lists
  (ok (equal '((:bullet-list t (((:paragraph ((:strong ("Lisp")) " — a language")))
                                ((:paragraph ((:strong ("Org")) " — a format"))))))
             (po "- Lisp :: a language" "- Org :: a format")))
  (ok (equal '((:bullet-list t (((:paragraph ((:strong ((:emph ("term")))) " — " (:strong ("d"))))))))
             (po "- /term/ :: *d*"))
      "term and description parsed inline")
  (ok (equal '((:bullet-list t (((:paragraph ((:strong ("term")) " — on the next line"))))))
             (po "- term ::" "  on the next line"))
      "the description on the next line")
  (ok (equal '((:bullet-list t (((:paragraph ((:strong ("term")))) (:code-block nil ("x"))))))
             (po "- term ::" "  #+begin_example" "  x" "  #+end_example"))
      "no paragraph: the term gets its own")
  (ok (equal '((:bullet-list t (((:paragraph ((:strong ("a")) " — b :: c"))))))
             (po "- a :: b :: c"))
      "the first :: separates")
  (ok (equal '((:bullet-list t (((:paragraph ("a::b")))))) (po "- a::b"))
      ":: needs blanks around it")
  (ok (equal '((:ordered-list 1 #\. t (((:paragraph ("a :: b")))))) (po "1. a :: b"))
      "ordered items have no terms"))
