(in-package #:org-markup/tests)

(defun pi* (string)
  "The inlines of STRING as one paragraph."
  (let ((blocks (org:parse-org string)))
    (assert (and (= 1 (length blocks)) (eq :paragraph (first (first blocks)))))
    (second (first blocks))))

(deftest inline-emphasis
  (ok (equal '((:strong ("a"))) (pi* "*a*")))
  (ok (equal '((:emph ("a"))) (pi* "/a/")))
  (ok (equal '((:emph ("a"))) (pi* "_a_")) "underline → :emph (the AST has no underline)")
  (ok (equal '((:strike ("a"))) (pi* "+a+")))
  (ok (equal '("x " (:strong ("a b")) " y") (pi* "x *a b* y")))
  (ok (equal '((:strong ("bold " (:emph ("it"))))) (pi* "*bold /it/*")) "nested")
  (ok (equal '((:emph ((:strong ("a"))))) (pi* "/*a*/")) "nested at the contents' start")
  (ok (equal '((:strong ("a")) " b*") (pi* "*a* b*")) "the first closing marker wins")
  (ok (equal '((:strong ("a *b")) " c*") (pi* "*a *b* c*"))
      "a marker after a blank does not close; org's non-greedy match")
  (ok (equal '("(" (:strong ("a")) ")") (pi* "(*a*)")))
  (ok (equal '("-" (:emph ("a")) "-") (pi* "-/a/-")))
  (ok (equal '("{" (:strike ("a")) "}") (pi* "{+a+}")))
  (ok (equal '("'" (:emph ("q")) "'") (pi* "'/q/'")))
  (ok (equal '("\"" (:emph ("q")) "\"") (pi* "\"/q/\"")))
  (ok (equal '((:strong ("a")) ". " (:strong ("b")) ", " (:strong ("c")) "; " (:strong ("d")) ": "
               (:strong ("e")) "! " (:strong ("f")) "? " (:strong ("g")) "[x]")
             (pi* "*a*. *b*, *c*; *d*: *e*! *f*? *g*[x]"))
      "closing markers before punctuation")
  (ok (equal '((:strong ("a")) "\\b") (pi* "*a*\\b")) "a backslash may follow")
  (ok (equal '((:strong ("a" (:soft-break) "b"))) (pi* (nl "*a" "b*"))) "one newline inside")
  (ok (equal '("*a" (:soft-break) "b" (:soft-break) "c*") (pi* (nl "*a" "b" "c*")))
      "two newlines: no emphasis"))

(deftest inline-emphasis-negative
  (ok (equal '("snake_case_word") (pi* "snake_case_word")) "intraword _")
  (ok (equal '("see a/b/c and /usr/local/bin") (pi* "see a/b/c and /usr/local/bin")) "paths")
  (ok (equal '("2*3*4 = 24") (pi* "2*3*4 = 24")))
  (ok (equal '("x*a*") (pi* "x*a*")) "the opening marker must follow a blank or -({'\"")
  (ok (equal '("*a*b") (pi* "*a*b")) "the closing marker must precede a blank or punctuation")
  (ok (equal '("a * b * c") (pi* "a * b * c")) "a blank after the opening marker")
  (ok (equal '("*a *") (pi* "*a *")) "a blank before the closing marker")
  (ok (equal '("a ** b") (pi* "a ** b")) "no contents")
  (ok (equal '("a+b+c and 1+1") (pi* "a+b+c and 1+1")))
  (ok (equal '("=x") (pi* "=x")) "unclosed code")
  (ok (equal '("\\*a*") (pi* "\\*a*")) "no backslash escapes: the marker follows a backslash"))

(deftest inline-code
  (ok (equal '((:code "x")) (pi* "=x=")))
  (ok (equal '((:code "x")) (pi* "~x~")))
  (ok (equal '("run " (:code "cl-repo test") ".") (pi* "run ~cl-repo test~.")))
  (ok (equal '((:code "*a* /b/ [[c]]")) (pi* "=*a* /b/ [[c]]=")) "code contents are literal")
  (ok (equal '((:code "a = b")) (pi* "=a = b=")) "a marker after a blank does not close")
  (ok (equal '((:code "a b")) (pi* (nl "=a" "b="))) "a newline becomes a space")
  (ok (equal '((:strong ((:code "x")))) (pi* "*=x=*")) "code inside emphasis"))

(deftest inline-bracket-links
  (ok (equal '((:link "https://orgmode.org" ("Org"))) (pi* "[[https://orgmode.org][Org]]")))
  (ok (equal '((:link "https://x.y" ("https://x.y"))) (pi* "[[https://x.y]]")) "no description")
  (ok (equal '((:link "post.org" ("Post"))) (pi* "[[file:post.org][Post]]")) "file: stripped")
  (ok (equal '((:link "notes.org" ("notes.org"))) (pi* "[[file:notes.org]]")))
  (ok (equal '((:image "img/cat.png" ())) (pi* "[[file:img/cat.png]]")) "an image")
  (ok (equal '((:image "./a.JPG" ())) (pi* "[[./a.JPG]]")) "extensions in any case")
  (ok (equal '((:image "https://x.y/badge.svg" ())) (pi* "[[https://x.y/badge.svg]]")))
  (ok (equal '("a " (:image "b.webp" ()) " " (:image "c.gif" ()) " " (:image "d.jpeg" ()))
             (pi* "a [[b.webp]] [[c.gif]] [[d.jpeg]]")))
  (ok (equal '((:link "cat.png" ("A cat"))) (pi* "[[cat.png][A cat]]"))
      "an image target with a description is a link")
  (ok (equal '((:link "u" ((:emph ("em")) " x"))) (pi* "[[u][/em/ x]]")) "description parsed inline")
  (ok (equal '((:link "https://x.y" ((:image "thumb.png" ())))) (pi* "[[https://x.y][[[file:thumb.png]]]]"))
      "an image link in a description")
  (ok (equal '((:link "big.jpg" ((:image "thumb.jpg" ())))) (pi* "[[file:big.jpg][file:thumb.jpg]]"))
      "a description that is an image link")
  (ok (equal '((:link "u" ("see https://x.y and <https://z.w>"))) (pi* "[[u][see https://x.y and <https://z.w>]]"))
      "no plain or angle links inside links")
  (ok (equal '((:link "u" ("a [[v][b]] c"))) (pi* "[[u][a [[v][b]] c]]")) "no bracket links inside links")
  (ok (equal '((:link "u" ("see [1]"))) (pi* "[[u][see [1]]]")) "balanced brackets in a description")
  (ok (equal '((:link "a]b" ("x"))) (pi* "[[a\\]b][x]]")) "escaped bracket in the target")
  (ok (equal '((:link "a\\b" ("x"))) (pi* "[[a\\\\b][x]]")) "escaped backslash")
  (ok (equal '((:link "u" ("u"))) (pi* "[[u][]]")) "an empty description counts as none")
  (ok (equal '((:link "u" ("a" (:soft-break) "b"))) (pi* (nl "[[u][a" "b]]"))) "a description over two lines")
  (ok (equal '((:link "a b" ("a b"))) (pi* (nl "[[a" "b]]"))) "a newline in a target → a space")
  (ok (equal '((:strong ("see " (:link "u" ("x"))))) (pi* "*see [[u][x]]*")) "a link in emphasis")
  (ok (equal '("[[a[b]]") (pi* "[[a[b]]")) "an unescaped [ in the target")
  (ok (equal '("[[]] [[][x]]") (pi* "[[]] [[][x]]")) "empty targets")
  (ok (equal '("[x] [fn:1] [2/3] [[u]") (pi* "[x] [fn:1] [2/3] [[u]")) "not links"))

(deftest inline-plain-and-angle-links
  (ok (equal '("see " (:link "https://example.com/a_b" ("https://example.com/a_b")) ".")
             (pi* "see https://example.com/a_b."))
      "trailing punctuation dropped; no emphasis inside")
  (ok (equal '("(" (:link "http://x.y/z" ("http://x.y/z")) ")") (pi* "(http://x.y/z)")))
  (ok (equal '((:link "https://x.y/?q=1&r=2" ("https://x.y/?q=1&r=2")) ", b")
             (pi* "https://x.y/?q=1&r=2, b")))
  (ok (equal '("write " (:link "mailto:me@x.y" ("mailto:me@x.y")) "!") (pi* "write mailto:me@x.y!")))
  (ok (equal '((:link "https://a.b/c" ("https://a.b/c")) "\"") (pi* "https://a.b/c\"")))
  (ok (equal '("xhttps://a.b") (pi* "xhttps://a.b")) "not after a letter")
  (ok (equal '("https:// and https://.") (pi* "https:// and https://.")) "nothing after the scheme")
  (ok (equal '("HTTPS://A.B ftp://c.d") (pi* "HTTPS://A.B ftp://c.d")) "lowercase http(s) and mailto only")
  (ok (equal '((:link "https://x.y/a b" ("https://x.y/a b"))) (pi* "<https://x.y/a b>")) "angle link")
  (ok (equal '("a " (:link "mailto:a@b.c" ("mailto:a@b.c")) " b") (pi* "a <mailto:a@b.c> b")))
  (ok (equal '("<2026-11-23 Mon> <<target>> <b>") (pi* "<2026-11-23 Mon> <<target>> <b>"))
      "timestamps, targets and tags are text")
  (ok (equal '("<" (:link "https://x" ("https://x"))) (pi* "<https://x")) "unclosed: a plain link"))

(deftest inline-breaks
  (ok (equal '("a" (:soft-break) "b") (pi* (nl "a" "b"))))
  (ok (equal '("a" (:hard-break) "b") (pi* (nl "a\\\\" "b"))))
  (ok (equal '("a" (:hard-break) "b") (pi* (nl "a  \\\\   " "  b"))) "blanks around the break")
  (ok (equal '("a") (pi* "a\\\\")) "at the end of the text: dropped")
  (ok (equal '("a \\\\ b") (pi* "a \\\\ b")) "inside a line: text")
  (ok (equal '("a\\\\\\" (:soft-break) "b") (pi* (nl "a\\\\\\" "b"))) "three backslashes: text"))

(deftest inline-other-text
  (ok (equal '("\\alpha $x^2$ \\(y\\) {{{macro}}} @@html:<b>@@ a_b x^2 [fn:note] <<t>> [50%]")
             (pi* "\\alpha $x^2$ \\(y\\) {{{macro}}} @@html:<b>@@ a_b x^2 [fn:note] <<t>> [50%]"))
      "entities, math, macros, snippets, sub/superscripts, footnotes, targets, cookies")
  (ok (equal '("That's all -- see ...") (pi* "That's all -- see ..."))))
