(in-package #:org-markup/tests)

(deftest keywords-collected
  (multiple-value-bind (blocks keywords)
      (org:parse-org (nl "#+TITLE: My post" "#+DATE: 2026-11-23" "" "text"))
    (ok (equal '((:paragraph ("text"))) blocks) "keyword lines leave the blocks")
    (ok (equal '(("title" . "My post") ("date" . "2026-11-23")) keywords)))
  (ok (equal '(("title" . "spaced out")) (kw "#+title:   spaced out   ")) "key downcased, value trimmed")
  (ok (equal '(("filetags" . "")) (kw "#+FILETAGS:")) "an empty value")
  (ok (equal '(("author" . "me")) (kw "  #+Author: me")) "indented")
  (ok (equal '(("date" . "<2026-11-23 Mon 10:00>")) (kw "#+DATE: <2026-11-23 Mon 10:00>"))
      "the key ends at the first colon")
  (ok (equal '(("options" . "toc:nil num:nil")) (kw "#+OPTIONS: toc:nil num:nil")))
  (ok (equal '(("title" . "a") ("date" . "d") ("title" . "b"))
             (kw "#+TITLE: a" "* h" "#+DATE: d" "text" "#+TITLE: b"))
      "source order; a repeated key appears again")
  (ok (equal '(("include" . "\"other.org\"")) (kw "#+INCLUDE: \"other.org\""))
      "#+INCLUDE is just a keyword")
  (ok (null (kw "text")) "no keywords")
  (ok (null (nth-value 1 (org:parse-org ""))) "empty input"))

(deftest keywords-dropped
  (multiple-value-bind (blocks keywords)
      (org:parse-org (nl "#+CAPTION: A cat" "#+NAME: fig:cat" "#+ATTR_HTML: :width 300"
                         "#+attr_latex: :float t" "[[file:cat.png]]"))
    (ok (null keywords) "affiliated keywords are not collected")
    (ok (equal '((:paragraph ((:image "cat.png" ())))) blocks) "and leave the blocks"))
  (ok (null (kw "#+RESULTS:" ": 42" "#+HEADER: :var x=1" "#+PLOT: title:x"
                "| a |" "#+TBLFM: $1=1" "#+CAPTION[short]: long"))
      "results header plot tblfm, and an optional [..] after the key")
  (ok (null (kw "#+BEGIN_SRC lisp" "#+END_SRC" "#+BEGIN: dyn" "#+END:"))
      "block lines are not keywords")
  (ok (equal '((:paragraph ("#+foo bar" (:soft-break) "#+: x"))) (po "#+foo bar" "#+: x"))
      "no colon, or no key: text")
  (ok (null (kw "#+foo bar" "#+: x"))))

(deftest keywords-by-context
  (multiple-value-bind (blocks keywords)
      (org:parse-org (nl "#+begin_src org" "#+TITLE: inner" "#+end_src"))
    (ok (null keywords) "not inside a src block")
    (ok (equal '((:code-block "org" ("#+TITLE: inner"))) blocks)))
  (multiple-value-bind (blocks keywords)
      (org:parse-org (nl "#+begin_quote" "#+TITLE: q" "x" "#+end_quote"))
    (ok (null keywords) "not inside a quote block")
    (ok (equal '((:block-quote ((:paragraph ("x"))))) blocks) "but dropped there"))
  (ok (null (kw "#+begin_center" "#+KEY: v" "#+end_center")) "nor a special block")
  (multiple-value-bind (blocks keywords)
      (org:parse-org (nl "- a" "  #+KEY: v" "- b"))
    (ok (equal '(("key" . "v")) keywords) "collected inside a list item")
    (ok (equal '((:bullet-list t (((:paragraph ("a"))) ((:paragraph ("b")))))) blocks)))
  (ok (null (kw ":PROPERTIES:" "#+KEY: v" ":END:")) "not inside a drawer")
  (ok (equal '(("a" . "1")) (kw "#+A: 1" "* Draft :noexport:" "#+B: 2" "* COMMENT x" "#+C: 3"))
      "not inside a dropped subtree"))
